# Copy this file to .env and fill in the values (HOSTING.md, step 3, explains each one).
# Never commit .env or put it in the Docker image. On Koyeb these become environment variables.

# ── Required ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Long random string. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Firebase: copy each value from the service-account JSON (Firebase console → Project settings →
# Service accounts → Generate new private key).
FIREBASE_DATABASE_URL=https://<your-project>-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
# Paste the "private_key" value as one line, keeping the \n sequences, without the outer quotes.
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=

# Instructor sign-in codes are emailed from this account (Gmail: use an App Password).
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=
OTP_DEV_MODE=false
# Who may sign in as an instructor. Leave both empty and ANYONE can create an instructor account.
ALLOWED_EMAIL_DOMAINS=temple.edu
ALLOW_ANY_EDU=false

# Code runner: the same random token on the web service and on the runner service.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
RUNNER_TOKEN=
# Docker Compose sets this for you. On Koyeb: http://runner:8100 (the runner service's name).
# RUNNER_URL=

# ── Recommended in production ───────────────────────────────────────────────
# Shared session store so the server can run 4 workers (e.g. Upstash: rediss://default:...@...:6379).
# Docker Compose starts its own Redis, so leave it empty there.
REDIS_URL=

# ── Optional ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
APP_TITLE=AI Code Assistant API
# CORS_ORIGINS=*
# WEB_CONCURRENCY=4            # worker count (default: 4 with REDIS_URL, else 1)
# INSTRUCTOR_LOGIN_TTL_SEC=86400
# Models (defaults shown): COMPLETION_MODEL=gpt-6-sol  AGENT_MODEL=gpt-6-luna  BUG_MODEL=gpt-6-sol
#                          OPENAI_MODEL=gpt-5-nano    BUG_CLASSIFIER_MODEL=gpt-5-nano
# Code limits (defaults): CODE_MAX_CONCURRENT=40 CODE_MEMORY_MB=256 CODE_RUNS_PER_MINUTE=20
# Email notifications on submit: EMAIL_ENABLED=true NOTIFICATION_EMAIL=you@example.com
